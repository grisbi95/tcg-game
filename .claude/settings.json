{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/hooks/check_gdscript.py:*)",
      "Bash(bash .claude/hooks/check_changed_gdscript.sh:*)",
      "Bash(bash addons/gdUnit4/runtest.sh:*)",
      "Bash(tools/run_tests.sh:*)",
      "Bash(tools/lint.sh:*)",
      "Bash(.venv/bin/gdlint:*)",
      "Bash(.venv/bin/gdformat:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(tools/check_typing.sh:*)",
      "Bash(python3 -B -m unittest discover -s .claude/hooks:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Edit(/addons/**)",
      "Edit(/.godot/**)",
      "Edit(/.venv/**)",
      "Edit(/**/*.uid)",
      "Edit(/**/*.import)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_gdscript.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
