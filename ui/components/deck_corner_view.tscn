[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/components/deck_corner_view.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/card_back_view.tscn" id="2_back"]
[ext_resource type="PackedScene" path="res://ui/components/card_view.tscn" id="3_card"]

[node name="DeckCornerView" type="VBoxContainer"]
theme_type_variation = &"DeckCornerColumn"
script = ExtResource("1_script")

[node name="PileLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PileLabel"

[node name="Piles" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DeckCornerRow"

[node name="Deck" parent="Piles" instance=ExtResource("2_back")]
unique_name_in_owner = true
layout_mode = 2

[node name="DiscardSlot" type="Control" parent="Piles"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2

[node name="DiscardCard" parent="Piles/DiscardSlot" instance=ExtResource("3_card")]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
