[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/sources_view.gd" id="1_script"]

[node name="SourcesView" type="VBoxContainer"]
theme_type_variation = &"SourcesColumn"
script = ExtResource("1_script")

[node name="Counters" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardRow"

[node name="EssenceChip" type="PanelContainer" parent="Counters"]
unique_name_in_owner = true
custom_minimum_size = Vector2(124, 32)
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"EssenceChip"

[node name="EssenceRow" type="HBoxContainer" parent="Counters/EssenceChip"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"CardRow"

[node name="EssenceIcon" type="Control" parent="Counters/EssenceChip/EssenceRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(18, 18)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2

[node name="EssenceLabel" type="Label" parent="Counters/EssenceChip/EssenceRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CounterLabel"
text = "Essence"

[node name="EssenceValue" type="Label" parent="Counters/EssenceChip/EssenceRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CounterValueLabel"

[node name="SlotGrid" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SourceGrid"
columns = 5
